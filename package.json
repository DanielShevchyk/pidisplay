{
  "name": "pidisplay",
  "version": "0.1.0",
  "private": true,
  "description": "Customizable touch dashboard for a wall-mounted Raspberry Pi display",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
