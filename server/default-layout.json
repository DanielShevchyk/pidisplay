{
  "version": 1,
  "settings": {
    "columns": 6,
    "rows": 4,
    "rotateSeconds": 30,
    "resumeAfterSeconds": 60
  },
  "topBar": {
    "left": [
      {
        "id": "bar-clock",
        "widget": "clock",
        "config": {
          "showSeconds": false
        }
      }
    ],
    "right": [
      {
        "id": "bar-weather",
        "widget": "weather",
        "config": {}
      }
    ]
  },
  "pages": [
    {
      "id": "home",
      "name": "Home",
      "tiles": [
        {
          "id": "home-clock",
          "widget": "clock",
          "size": "large",
          "config": {
            "style": "digital"
          }
        },
        {
          "id": "home-analog",
          "widget": "clock",
          "size": "large",
          "config": {
            "style": "analog"
          }
        },
        {
          "id": "home-weather",
          "widget": "weather",
          "size": "large",
          "config": {}
        },
        {
          "id": "home-utc",
          "widget": "clock",
          "size": "medium",
          "config": {
            "timeZone": "UTC",
            "label": "UTC"
          }
        },
        {
          "id": "home-tokyo",
          "widget": "clock",
          "size": "small",
          "config": {
            "timeZone": "Asia/Tokyo",
            "label": "Tokyo"
          }
        },
        {
          "id": "home-london",
          "widget": "clock",
          "size": "small",
          "config": {
            "timeZone": "Europe/London",
            "label": "London"
          }
        }
      ]
    },
    {
      "id": "weather",
      "name": "Weather",
      "tiles": [
        {
          "id": "weather-full",
          "widget": "weather",
          "size": "full",
          "config": {}
        }
      ]
    },
    {
      "id": "clock",
      "name": "Clock",
      "tiles": [
        {
          "id": "clock-full",
          "widget": "clock",
          "size": "full",
          "config": {
            "style": "digital",
            "showSeconds": true
          }
        }
      ]
    },
    {
      "id": "system",
      "name": "System",
      "tiles": [
        {
          "id": "system-full",
          "widget": "system",
          "size": "full",
          "config": {}
        }
      ]
    },
    {
      "id": "travel",
      "name": "Travel",
      "tiles": [
        {
          "id": "travel-deal",
          "widget": "fares",
          "size": "large",
          "config": {}
        },
        {
          "id": "travel-list",
          "widget": "fares",
          "size": "xlarge",
          "config": {
            "showUnverified": true
          }
        }
      ]
    }
  ]
}
